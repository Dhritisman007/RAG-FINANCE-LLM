# FinRAG — paths relative to finrag/

# Private portfolio data — never committed
data/portfolio/holdings.csv
data/portfolio/*.db

# Secrets
.env

# Stale local vector stores (the live store is ~/.finrag_chroma_db)
data/chroma_db/
data/vectorstore/

# Python
__pycache__/

# macOS AppleDouble files (exFAT drive)
._*

# Evaluation checkpoints (in-progress runs)
data/eval/.partial_*.jsonl

# Price data (market prices change daily; manual prices can reveal holdings)
data/portfolio/market_prices.csv
data/portfolio/manual_prices.csv

# Local run logs
data/logs/
data/portfolio/*.tmp
data/portfolio/yahoo_prices.csv

# Cached annual-report PDFs (Day 18) — large; the extracted text is what the pipeline uses
data/pdf_cache/

# Which model the local MLX server is serving (written by scripts/start_mlx_server.sh)
data/mlx_serving.txt

# Portfolio ingestion (broker sync) — never commit real positions or credentials
.env.*
!.env.example
data/portfolio/*.db
data/portfolio/*.db-journal
data/portfolio/*.db-wal
data/portfolio/*.csv
data/portfolio/imports/
*.local.json
config/broker_mappings/*
!config/broker_mappings/generic_example.json

# Streamlit secrets (Google sign-in client secret, cookie secret)
.streamlit/secrets.toml

# Mutual fund NAVs from AMFI (public, refreshed daily)
data/portfolio/amfi_nav.csv
