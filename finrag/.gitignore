# FinRAG — paths relative to finrag/

# Private portfolio data — never committed
data/portfolio/holdings.csv
data/portfolio/*.db

# Secrets
.env

# Stale local vector stores (the live store is ~/.finrag_chroma_db)
data/chroma_db/
data/vectorstore/

# Python
__pycache__/

# macOS AppleDouble files (exFAT drive)
._*

# Evaluation checkpoints (in-progress runs)
data/eval/.partial_*.jsonl

# Price data (market prices change daily; manual prices can reveal holdings)
data/portfolio/market_prices.csv
data/portfolio/manual_prices.csv

# Local run logs
data/logs/
data/portfolio/*.tmp
data/portfolio/yahoo_prices.csv
